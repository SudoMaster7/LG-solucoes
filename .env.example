# URL pública do site (sem barra no final). Usada em canonical, sitemap, Open Graph e JSON-LD.
NEXT_PUBLIC_SITE_URL=https://[DOMÍNIO]

# ID do Pixel da Meta. Vazio = Pixel desligado. Só carrega depois do aceite de cookies.
NEXT_PUBLIC_META_PIXEL_ID=

# Distribuição do WhatsApp: "random" (50/50 fixo por visitante) ou "fixed:atendente-1" / "fixed:atendente-2"
NEXT_PUBLIC_WHATSAPP_ROUTING=random

# Conversions API (servidor). Deixe false até configurar o token.
ENABLE_CAPI=false
NEXT_PUBLIC_ENABLE_CAPI=false
META_CAPI_ACCESS_TOKEN=
# Código de teste do Gerenciador de Eventos (opcional, só para testar)
META_CAPI_TEST_EVENT_CODE=

# Formulário de lead: para onde o /api/leads envia os dados (webhook do CRM). Vazio = só registra no log.
LEADS_WEBHOOK_URL=
